{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Spitzli Cloud",
  "description": "Guides for your Spitzli Cloud workspace, provider connections, applications, websites and developer integrations.",
  "colors": {
    "primary": "#6515D5",
    "light": "#C6A3FF",
    "dark": "#6515D5"
  },
  "favicon": "/favicon.svg",
