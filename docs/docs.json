              "guides/console",
              "guides/access"
            ]
          },
          {
            "group": "Products",
            "pages": [
              "guides/websites",
              "guides/managed-cms",
              "guides/applications",
              "guides/project-setup",
              "guides/git-deployments",
              "guides/storage",
              "guides/databases",
              "guides/mail",
              "guides/plans-and-billing"
            ]
          },
          {
            "group": "Connect your providers",
            "pages": [
              "guides/byok",
              "guides/byok-neon",
              "guides/byok-kubernetes",
              "guides/byok-vercel",
              "guides/byok-mail"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "guides/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "groups": [
          {
            "group": "Integrations",
            "pages": [
              "developers/overview",
              "developers/authentication",
              "developers/mcp",
              "developers/byok",
              "developers/registry",
              "developers/website-integration"
            ]
          },
          {
