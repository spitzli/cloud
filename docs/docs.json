              "developers/mail-quickstart",
              "developers/mail-api",
              "developers/mail-webhooks"
            ]
          },
          {
            "group": "Plugins",
            "pages": [
              "developers/plugins",
              "developers/plugin-releases",
              "developers/managed-apps",
              "developers/managed-analytics",
              "developers/project-notes",
              "developers/plugin-manifest",
              "developers/plugin-api-mcp",
              "developers/plugin-jobs",
              "developers/managed-registry"
            ]
          },
          {
            "group": "Self-hosting",
            "pages": [
              "developers/self-hosting",
              "developers/core-distribution",
              "developers/initial-setup",
              "developers/modules",
              "developers/auth-adapters"
