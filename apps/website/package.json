{
  "name": "@spitzli/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint",
    "test": "bun test --isolate ./tests",
    "payload": "bun --env-file=.env.instance ../../node_modules/payload/bin.js --disable-transpile",
    "cms:types": "bun run payload generate:types",
    "cms:migrate": "PAYLOAD_MIGRATING=true bun run payload migrate",
    "test:prefetch": "bun tests/intent-prefetch-production.mjs",
    "test:sso-policy": "bun test --isolate ./tests/sso-policy.test.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "payload": "4.0.0-canary.37",
    "@payloadcms/next": "4.0.0-canary.37",
    "@payloadcms/ui": "4.0.0-canary.37",
    "@payloadcms/db-postgres": "4.0.0-canary.37",
    "@payloadcms/email-nodemailer": "4.0.0-canary.37",
    "nodemailer": "10.0.13",
    "graphql": "16.14.2",
    "sharp": "0.35.5",
    "@spitzli/instance-kit": "*",
    "@spitzli/payload-sso": "*",
    "@spitzli/cms-ui": "*",
    "@spitzli/i18n": "*",
    "@spitzli/database-runtime": "*",
    "@spitzli/cms-bridge": "*"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/nodemailer": "^8.0.2"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "type": "module",
  "license": "Apache-2.0"
}
