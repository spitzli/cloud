{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "webdock-build-controller",
        "labels": {
          "webdock.dev/owner": "managed-build-controller",
          "pod-security.kubernetes.io/enforce": "restricted"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ResourceQuota",
      "metadata": {
        "name": "identity-only",
        "namespace": "webdock-build-controller"
      },
      "spec": {
        "hard": {
          "pods": "0",
          "secrets": "1",
          "configmaps": "0",
          "persistentvolumeclaims": "0",
          "services": "0"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "webdock-build-controller",
        "namespace": "webdock-build-controller"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1",
      "kind": "Secret",
      "metadata": {
        "name": "webdock-controller-revocation",
        "namespace": "webdock-build-controller"
      },
      "type": "Opaque",
      "immutable": true,
      "stringData": {
        "revocation-marker": "owned-controller-v1"
      }
    }
  ]
}
