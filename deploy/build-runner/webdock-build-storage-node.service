[Unit]
Description=Signed Webdock fixed build-volume node controller
Requires=k3s.service
After=k3s.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/webdock-build-host

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/webdock-build-storage/connection.env
ExecStart=/usr/local/libexec/webdock-build-storage-node --config /etc/webdock-build-storage/pool.json --trust /etc/webdock-build-storage/trust.json --kubeconfig /etc/webdock-build-storage/node.kubeconfig --context ${BUILD_STORAGE_CONTEXT} --endpoint ${BUILD_STORAGE_API} --ca-sha256 ${BUILD_STORAGE_CA_SHA256} --namespace webdock-build-qualification --requests-namespace webdock-build-storage-requests --receipts-namespace webdock-build-storage-receipts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_MKNOD
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryMax=512M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
LimitNOFILE=4096
LimitCORE=0
# Mounts must propagate to the host kubelet. Do not add PrivateMounts,
# ProtectSystem, ProtectHome or PrivateTmp without qualifying propagation.
# This privileged infrastructure process never executes tenant content.

[Install]
WantedBy=multi-user.target
