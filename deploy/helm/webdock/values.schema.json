{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "buildController": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "namespaceProfile",
        "existingPrivatePVC",
        "credentialConfigExistingSecret",
        "privateControlURL",
        "network",
        "tlsUpload",
        "privateCoreTLSExistingService",
        "privateCoreTLSNamespace"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "namespaceProfile": {
          "enum": [
            "",
            "trusted-controller-root-tmpfs-v1"
          ]
        },
        "existingPrivatePVC": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "credentialConfigExistingSecret": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "privateControlURL": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^$|^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?/api/hosting/git/worker$"
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dnsIPv4",
            "coreHTTPSIPv4",
            "buildAPIIPv4",
            "registryHTTPSIPv4",
            "stagingHTTPSIPv4"
          ],
          "properties": {
            "dnsIPv4": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              }
            },
            "coreHTTPSIPv4": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              }
            },
            "buildAPIIPv4": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              }
            },
            "registryHTTPSIPv4": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              }
            },
            "stagingHTTPSIPv4": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
              }
            }
          }
        },
        "tlsUpload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "image",
            "existingTLSSecret",
            "host",
            "sourceIPv4CIDRs"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "pattern": "^$|^docker.io/library/caddy@sha256:[a-f0-9]{64}$"
            },
            "existingTLSSecret": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            },
            "host": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
            },
            "sourceIPv4CIDRs": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/([1-9]|[12][0-9]|3[0-2])$"
              }
            }
          }
        },
        "privateCoreTLSExistingService": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "privateCoreTLSNamespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        }
      }
    },
    "agentControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingEnvSecret",
        "existingPrivatePVC",
        "privateMTLSReviewed",
        "networkAdmissionExistingPolicy",
        "privateSourceIPv4"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingEnvSecret": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "existingPrivatePVC": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "privateMTLSReviewed": {
          "type": "boolean"
        },
        "networkAdmissionExistingPolicy": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
        },
        "privateSourceIPv4": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
          }
        }
      }
    },
    "databaseCAConfigMap": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "databaseHostAliases": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ip",
          "hostnames"
        ],
        "properties": {
          "ip": {
            "type": "string",
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
          },
          "hostnames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
            }
          }
        }
      }
    }
  }
}
