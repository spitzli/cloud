# Backend compilation inputs only; no frontend installation, local state or credentials.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!clippy.toml
!crates/**
!proto/**
!legacy/control-plane/drizzle/**
!tools/migrations/baseline.sha256
!plugins/**
!vendor/**
!LICENSE
!COMMERCIAL-LICENSING.md
!NOTICE
**/target
**/node_modules
**/.git
**/.env*
**/*.env
**/*.env.*
**/*.pem
**/*.key
**/*credentials*.json
**/*secrets*.json
**/*private*.json
**/*.dump
**/*.sqlite*
**/*.db
**/*kubeconfig*
**/.npmrc
**/.netrc
**/*.log
