# Own table only. Numeric UID 13 is verified as the maintained Ubuntu proxy account.
flush table inet webdock_package_proxy
table inet webdock_package_proxy {
  set denied_v4 {
    type ipv4_addr
    flags interval
    elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 213.136.65.22, 79.143.177.157, 169.58.95.66, 167.86.75.144 }
  }
  chain input_guard {
    type filter hook input priority -100; policy accept;
    ip saddr 10.84.0.0/16 ip daddr 10.83.0.1 tcp dport 3128 accept
    tcp dport 3128 counter drop
  }
  chain proxy_output {
    type filter hook output priority -100; policy accept;
    # Replies to approved Pod-initiated proxy sessions are not upstream connections.
    meta skuid 13 ip daddr 10.84.0.0/16 tcp sport 3128 ct state established accept
    meta skuid 13 ip daddr 127.0.0.53 udp dport 53 accept
    meta skuid 13 ip daddr 127.0.0.53 tcp dport 53 accept
    meta skuid 13 ip daddr @denied_v4 counter reject
    # No mapped, NAT64, link-local or other IPv6 route can bypass the IPv4 deny set.
    meta skuid 13 meta nfproto ipv6 counter reject
    meta skuid 13 meta nfproto ipv4 tcp dport 443 accept
    meta skuid 13 counter reject
  }
}
