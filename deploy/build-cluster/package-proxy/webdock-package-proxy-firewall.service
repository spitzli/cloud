[Unit]
Description=Owned Webdock package gateway firewall boundary
After=webdock-build-network.service
Requires=webdock-build-network.service
Before=webdock-package-proxy.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/webdock-package-proxy-manage --firewall
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/lock
CapabilityBoundingSet=CAP_NET_ADMIN
[Install]
WantedBy=multi-user.target
