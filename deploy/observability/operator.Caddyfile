{
 admin off
 persist_config off
 email dominik@spitzli.dev
 acme_ca https://acme-v02.api.letsencrypt.org/directory
 servers {
  protocols h1 h2
 }
}

grafana.spitzli.cloud {
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  -Server
 }
 # Native Grafana login; no trusted-header authentication.
 reverse_proxy 10.93.123.214:80 {
  header_up -X-WEBAUTH-USER
  header_up -X-Forwarded-User
 }
}

prometheus.spitzli.cloud {
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  -Server
 }
 route {
  basic_auth {
   webdock-operator {$SPITZLI_OBS_OPERATOR_HASH}
  }
  @admin path /-/quit /-/reload /api/v1/admin/* /api/v1/write /api/v1/otlp/* /debug/*
  respond @admin 404
  reverse_proxy 10.93.19.229:9090 {
   header_up -Authorization
  }
 }
}

grafana.webdock.dev {
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  -Server
 }
 redir https://grafana.spitzli.cloud{uri} 308
}

prometheus.webdock.dev {
 header {
  Strict-Transport-Security "max-age=31536000"
  X-Content-Type-Options nosniff
  -Server
 }
 redir https://prometheus.spitzli.cloud{uri} 308
}
