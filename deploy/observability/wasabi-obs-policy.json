{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyObsBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::webdock-obs-eu-100210955"
    },
    {
      "Sid": "ObsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::webdock-obs-eu-100210955/*"
    },
    {
      "Sid": "NoOtherS3Resources",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": [
        "arn:aws:s3:::webdock-obs-eu-100210955",
        "arn:aws:s3:::webdock-obs-eu-100210955/*"
      ]
    },
    {
      "Sid": "NoIamAdministration",
      "Effect": "Deny",
      "Action": "iam:*",
      "Resource": "*"
    },
    {
      "Sid": "RequireTls",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::webdock-obs-eu-100210955",
        "arn:aws:s3:::webdock-obs-eu-100210955/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
